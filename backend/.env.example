# Telephony provider: android_sim (default, China mainland) or bland
TELEPHONY_PROVIDER=android_sim
# One Android SIM can carry one cellular voice call at a time.
MAX_CONCURRENT_CALLS=1
# Keep calls short and spaced out when testing a third-party IVR.
ROOT_CALL_MAX_DURATION=60
BRANCH_CALL_MAX_DURATION=60
CALL_COOLDOWN_SECONDS=0

# --- Bland AI (only needed when TELEPHONY_PROVIDER=bland) ---
BLAND_API_KEY=your_key_here

# --- Android SIM gateway (only needed when TELEPHONY_PROVIDER=android_sim) ---
# FreeSWITCH Event Socket, used to originate the call and forward DTMF.
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=18021
FREESWITCH_ESL_PASSWORD=CHANGE_ME
# SIP domain FreeSWITCH serves (the Mac's LAN IPv4).
FREESWITCH_DOMAIN=192.168.10.112
# Registered SIP extensions for the gateway phone and the verifying softphone.
SIP_GATEWAY_EXTENSION=gateway1
SIP_SOFTPHONE_EXTENSION=softphone
# Wait for the first IVR prompt to finish before sending the first DTMF key.
CALL_DTMF_INITIAL_DELAY=8
CALL_DTMF_KEY_GAP=2
# FreeSWITCH writes one 8 kHz WAV per outbound call here for ASR.
CALL_RECORDING_DIR=/tmp/ivr-discovery-recordings
# Optional recording/lookup tuning.
CALL_CHANNEL_LOOKUP_TIMEOUT=10
CALL_RECORDING_START_TIMEOUT=30
CALL_RECORDING_FINALIZE_TIMEOUT=5

# --- AI (transcript parsing) ---
# Default for the China mainland scenario. Uses DeepSeek's OpenAI-compatible API.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_key_here
# Optional overrides; defaults are https://api.deepseek.com and deepseek-flash.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic (optional, set AI_PROVIDER=anthropic to use) ---
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Tencent Cloud audio (ASR/TTS, required by android_sim) ---
# Create a CAM key with ASR and TTS access. Never commit the real values.
AUDIO_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=your_secret_id
TENCENTCLOUD_SECRET_KEY=your_secret_key
TENCENTCLOUD_APP_ID=your_app_id
TENCENTCLOUD_REGION=ap-guangzhou
# 8k_zh is covered by Tencent's free recording-recognition package.
# 8k_zh_large is optional and requires a separate large-model quota.
TENCENT_ASR_ENGINE_MODEL=8k_zh
# FreeSWITCH records both call legs as stereo when RECORD_STEREO=true.
TENCENT_ASR_CHANNEL_NUM=2
# Realtime WebSocket ASR uses the separate realtime quota.
TENCENT_REALTIME_ASR_ENGINE_MODEL=16k_zh
# Local realtime relay used to wait for menu readiness before DTMF injection.
REALTIME_RELAY_URL=ws://127.0.0.1:18031
REALTIME_DTMF_ENABLED=1
# Known 1w2 path: send the second key after this delay if realtime English ASR
# does not produce a target-key event. Only applies to the 1 -> 2 sequence.
CALL_DTMF_FALLBACK_DELAY_MS=16000
# Optional JSON map for deterministic corrections of known ASR phrase errors.
ASR_PHRASE_CORRECTIONS_JSON={}
# Optional. Choose a voice from the Tencent Cloud voice list.
TENCENT_TTS_VOICE_TYPE=
TENCENT_TTS_SAMPLE_RATE=8000

# --- Shadow LLM judgment (ADR 0040, default OFF) ---
# When enabled, a DeepSeek classifier runs alongside the deterministic rules and
# may veto an action (block DTMF, cancel a rule-driven hangup, or defer a key on
# an automated notice). It can never pick a key or advance navigation. Enable
# only after offline calibration against historical recordings meets the gates
# in docs/adr/0040-model-shadow-judgment-and-safety-veto.md.
SHADOW_JUDGMENT_ENABLED=0
SHADOW_JUDGMENT_TIMEOUT_SECONDS=1.5
SHADOW_JUDGMENT_AUDIT_DIR=/tmp/ivr-discovery-shadow
# Backend-enforced veto window for a human-boundary hanging decision.
SHADOW_BOUNDARY_CANCEL_WINDOW_MS=1500
# One-time listening extension when the model reads an automated notice.
SHADOW_AUTOMATED_NOTICE_EXTENSION_MS=10000
